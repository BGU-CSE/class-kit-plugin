{
  "permissions": {
    "allow": [
      "Bash(classkit validate:*)",
      "Bash(.venv/bin/classkit validate:*)",
      "Bash(.venv/Scripts/classkit validate:*)",
      "Bash(classkit status:*)",
      "Bash(.venv/bin/classkit status:*)",
      "Bash(.venv/Scripts/classkit status:*)",
      "Bash(classkit doctor:*)",
      "Bash(.venv/bin/classkit doctor:*)",
      "Bash(.venv/Scripts/classkit doctor:*)",
      "Bash(classkit ingest --preflight:*)",
      "Bash(.venv/bin/classkit ingest --preflight:*)",
      "Bash(.venv/Scripts/classkit ingest --preflight:*)",
      "Bash(classkit mode)",
      "Bash(.venv/bin/classkit mode)",
      "Bash(.venv/Scripts/classkit mode)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/report-mode.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
